{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    // Public OAuth client id of the Web client (not a secret). Its authorized JavaScript origins must list every
    // origin that serves the app; an empty string hides the Google button.
    "GOOGLE_CLIENT_ID": "108612065622-26l3rjji9ogsnh62781gul0028rme9ve.apps.googleusercontent.com"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 19 * * *"]
  },
  // Live updates (group_live_updates): one GroupLive Durable Object per group code. The class is exported from
  // worker/index.ts; the binding name is the Worker env key.
  "durable_objects": {
    "bindings": [{ "name": "GROUP_LIVE", "class_name": "GroupLive" }],
  },
  // Durable Object migrations, not the D1 migrations_dir. Tag v1 creates the SQLite-backed GroupLive class;
  // wrangler deploy applies it on a remote deploy.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroupLive"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tally",
      // The D1 database of the deployed app. Local dev does not need a real id and uses its own local copy.
      // For a first deploy to another Cloudflare account, set this to the placeholder
      // "00000000-0000-0000-0000-000000000000", run `npx wrangler d1 create tally` and paste the id it prints
      // (see docs/design.md, section 8).
      "database_id": "6e542aac-803c-4037-b851-8d3e9e7c8961",
      "migrations_dir": "migrations"
    }
  ]
}
